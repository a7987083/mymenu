+
+    std::vector<Vertex> vertices;
+    vertices.reserve(count() * 1600);
+    for (std::size_t i = 0; i < gMarks.size(); ++i) {
+        if (gMarks[i].active) {
+            appendMarkGeometry(vertices, i, gMarks[i]);
+        }
+    }
+    if (vertices.empty()) {
+        return;
+    }
+
+    IDirect3DStateBlock9* state = nullptr;
+    if (FAILED(device->CreateStateBlock(D3DSBT_ALL, &state)) || state == nullptr) {
+        return;
+    }
+    state->Capture();
+
+    device->SetTexture(0, nullptr);
+    device->SetFVF(kVertexFvf);
+    device->SetRenderState(D3DRS_ZENABLE, FALSE);
+    device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_LIGHTING, FALSE);
+    device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, TRUE);
+    device->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA);
+    device->SetRenderState(D3DRS_DESTBLEND, D3DBLEND_ONE);
+    device->SetRenderState(D3DRS_BLENDOP, D3DBLENDOP_ADD);
+    device->SetTextureStageState(0, D3DTSS_COLOROP, D3DTOP_SELECTARG1);
+    device->SetTextureStageState(0, D3DTSS_COLORARG1, D3DTA_DIFFUSE);
+    device->SetTextureStageState(0, D3DTSS_ALPHAOP, D3DTOP_SELECTARG1);
+    device->SetTextureStageState(0, D3DTSS_ALPHAARG1, D3DTA_DIFFUSE);
+
+    device->DrawPrimitiveUP(
+        D3DPT_TRIANGLELIST,
+        static_cast<UINT>(vertices.size() / 3),
+        vertices.data(),
+        sizeof(Vertex));
+
+    state->Apply();
+    state->Release();
+}
+
+} // namespace worldMarks
diff --strip-trailing-cr -ruN UnitXP_SP3-v89_original/unitxp_sp3/worldMarks.h UnitXP_SP3-v89_src/unitxp_sp3/worldMarks.h
--- UnitXP_SP3-v89_original/unitxp_sp3/worldMarks.h	1970-01-01 00:00:00.000000000 +0000
+++ UnitXP_SP3-v89_src/unitxp_sp3/worldMarks.h	2026-08-01 15:13:12.793238038 +0000
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <cstddef>
+#include <string>
+
+#include <d3d9.h>
+
+#include "Vanilla1121_functions.h"
+
+namespace worldMarks {
+
+struct MarkInfo {
+    std::string color;
+    C3Vector position;
+};
+
+// Places/replaces a mark of the requested color at the current mouse-ground hit.
+// Returns false when the color is unknown or no world surface is under the cursor.
+bool placeAtCursor(const std::string& colorName, C3Vector& placedPosition, std::string& normalizedColor);
+
+// Places/replaces a mark received from another addon client.
+bool placeRemote(const std::string& colorName, const C3Vector& position);
+
+void clearAll();
+std::size_t count();
+
+// Copies the active marks into caller storage. Returns number copied.
+std::size_t snapshot(MarkInfo* output, std::size_t capacity);
+
+// Draws all marks as a screen-space moonlight overlay. The function saves/restores
+// the Direct3D state it changes and owns no device resources.
+void draw(IDirect3DDevice9* device);
+
+} // namespace worldMarks
