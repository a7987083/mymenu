--- UnitXP_SP3-v89_original/unitxp_sp3/dllmain.cpp	2026-03-29 02:32:08.000000000 +0000
+++ UnitXP_SP3-v89_src/unitxp_sp3/dllmain.cpp	2026-08-01 15:13:42.705239120 +0000
@@ -32,6 +32,7 @@
 #include "polyfill.h"
 #include "sceneBegin_sceneEnd.h"
 #include "gameEvent.h"
+#include "worldMarks.h"
 
 using namespace std;
 
@@ -48,7 +49,72 @@
 }
 
 int __fastcall detoured_UnitXP(void* L) {
-    if (lua_gettop(L) >= 2) {
+    const int argumentCount = lua_gettop(L);
+
+    // Ground marker commands are handled before the legacy >=2 argument gate because
+    // ClearAllMarks and QueryMarks intentionally take only the command name.
+    if (argumentCount >= 1) {
+        const string markCommand{ lua_tostring(L, 1) };
+
+        if (markCommand == "2DMark" && argumentCount >= 2) {
+            C3Vector placedPosition = {};
+            std::string normalizedColor{};
+            if (worldMarks::placeAtCursor(lua_tostring(L, 2), placedPosition, normalizedColor)) {
+                lua_pushnumber(L, placedPosition.x);
+                lua_pushnumber(L, placedPosition.y);
+                lua_pushnumber(L, placedPosition.z);
+                lua_pushstring(L, normalizedColor);
+                return 4;
+            }
+            return 0;
+        }
+        else if (markCommand == "RemoteMark" && argumentCount >= 5
+                 && lua_isnumber(L, 3) && lua_isnumber(L, 4) && lua_isnumber(L, 5)) {
+            C3Vector remotePosition = {};
+            remotePosition.x = static_cast<float>(lua_tonumber(L, 3));
+            remotePosition.y = static_cast<float>(lua_tonumber(L, 4));
+            remotePosition.z = static_cast<float>(lua_tonumber(L, 5));
+            lua_pushboolean(L, worldMarks::placeRemote(lua_tostring(L, 2), remotePosition));
+            return 1;
+        }
+        else if (markCommand == "ClearAllMarks") {
+            worldMarks::clearAll();
+            lua_pushboolean(L, true);
+            return 1;
+        }
+        else if (markCommand == "QueryMarks") {
+            worldMarks::MarkInfo marks[7] = {};
+            const std::size_t markCount = worldMarks::snapshot(marks, 7);
+
+            lua_pushnumber(L, static_cast<double>(markCount));
+            lua_newtable(L);
+            for (std::size_t i = 0; i < markCount; ++i) {
+                lua_pushnumber(L, static_cast<double>(i + 1));
+                lua_newtable(L);
+
+                lua_pushstring(L, "color");
+                lua_pushstring(L, marks[i].color);
+                lua_settable(L, -3);
+
+                lua_pushstring(L, "x");
+                lua_pushnumber(L, marks[i].position.x);
+                lua_settable(L, -3);
+
+                lua_pushstring(L, "y");
+                lua_pushnumber(L, marks[i].position.y);
+                lua_settable(L, -3);
+
+                lua_pushstring(L, "z");
+                lua_pushnumber(L, marks[i].position.z);
+                lua_settable(L, -3);
+
+                lua_settable(L, -3);
+            }
+            return 2;
+        }
+    }
+
+    if (argumentCount >= 2) {
         string cmd{ lua_tostring(L, 1) };
 
         if (cmd == "addCombatText" && lua_gettop(L) >= 6) {
